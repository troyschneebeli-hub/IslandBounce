# Copy to .env.local and fill in once affiliate applications are approved.
NEXT_PUBLIC_12GO_PARTNER_ID=
NEXT_PUBLIC_KLOOK_AID=
NEXT_PUBLIC_VIATOR_PID=
NEXT_PUBLIC_GYG_PARTNER_ID=

# Server-only — no NEXT_PUBLIC_ prefix, never sent to the browser.
# Used by app/api/closest-port/route.js (Find My Closest Port page).
# In Google Cloud Console: enable "Distance Matrix API" on this key and
# restrict it to your server's IP address.
GOOGLE_MAPS_API_KEY=

# Once eventide.com is live, point this at the real domain.
NEXT_PUBLIC_EVENTIDE_URL=https://eventide.com
